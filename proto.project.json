{
  "name": "musou-genin-proto",
  "globIgnorePaths": ["**/*.spec.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ProtoRemotes": {
        "$className": "Folder",
        "SetMode": {
          "$className": "RemoteEvent"
        },
        "Snapshot": {
          "$className": "UnreliableRemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "ProtoServer": {
        "$path": "proto/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "ProtoClient": {
          "$path": "proto/client"
        }
      }
    },
    "Workspace": {
      "Floor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [1024, 4, 1024],
          "Position": [0, -2, 0],
          "Material": "Grass",
          "Color": [0.42, 0.55, 0.28],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0],
          "Neutral": true,
          "Duration": 0
        }
      }
    }
  }
}
