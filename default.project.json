{
  "name": "musou",
  "globIgnorePaths": ["**/*.spec.luau"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Weapons": {
        "$path": "assets/weapons"
      },
      "Remotes": {
        "$className": "Folder",
        "Action": {
          "$className": "RemoteEvent"
        },
        "SelectStage": {
          "$className": "RemoteEvent"
        },
        "SelectCharacter": {
          "$className": "RemoteEvent"
        },
        "SelectHikei": {
          "$className": "RemoteEvent"
        },
        "Shutsugeki": {
          "$className": "RemoteEvent"
        },
        "Retry": {
          "$className": "RemoteEvent"
        },
        "ReturnToLobby": {
          "$className": "RemoteEvent"
        },
        "SkipEventScene": {
          "$className": "RemoteEvent"
        },
        "PartyState": {
          "$className": "RemoteEvent"
        },
        "SelectionRejected": {
          "$className": "RemoteEvent"
        },
        "PlayEventScene": {
          "$className": "RemoteEvent"
        },
        "SkipCount": {
          "$className": "RemoteEvent"
        },
        "PlaySerifu": {
          "$className": "RemoteEvent"
        },
        "StageResult": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "DebugCommand": {
        "$className": "BindableFunction"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
